        <mxCell id="src" value="&lt;b&gt;허용 소스 4개&lt;/b&gt;&lt;br&gt;GeekNews&lt;br&gt;Show HN&lt;br&gt;itch.io devlogs&lt;br&gt;Ars Technica (업계 뉴스만)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f6f3;strokeColor=#dadad3;fontColor=#111111;fontSize=11;arcSize=12;" vertex="1" parent="1">
