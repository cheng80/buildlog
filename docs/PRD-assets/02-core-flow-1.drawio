        <mxCell id="ev2" value="&lt;font face=&quot;Menlo, monospace&quot;&gt;project_created&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;프로젝트 저장 성공 시&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7edfc;strokeColor=#3f5aa8;fontColor=#111111;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="220" width="170" height="50" as="geometry" />
