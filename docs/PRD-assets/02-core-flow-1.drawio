        <mxCell id="ev3" value="&lt;font face=&quot;Menlo, monospace&quot;&gt;post_published&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;처음 공개될 때 1회 (Release 포함)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7edfc;strokeColor=#3f5aa8;fontColor=#111111;fontSize=11;arcSize=12;" vertex="1" parent="1">
