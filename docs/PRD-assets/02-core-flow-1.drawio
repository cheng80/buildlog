<mxfile host="drawio" modified="2026-09-27T00:00:00.000Z" agent="claude-code" version="24.0.0" type="device">
  <diagram id="core-flow-1" name="핵심 흐름 1">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="그림 2. 핵심 흐름 1 — 첫 프로토타입이 반드시 돌아가게 할 흐름과 서버가 기록하는 행동 이벤트 5개" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;① 가입·로그인&lt;/b&gt;&lt;br&gt;GitHub · Google&lt;br&gt;표시 이름 · 핸들" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f6f3;strokeColor=#dadad3;fontColor=#111111;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;② 프로젝트 만들기&lt;/b&gt;&lt;br&gt;이름 · 한 줄 소개 · 기술" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f6f3;strokeColor=#dadad3;fontColor=#111111;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="90" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;③ 게시물 올리기&lt;/b&gt;&lt;br&gt;스크린샷 또는 유튜브 링크&lt;br&gt;+ 한 줄 (내용 하나면 게시)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f6f3;strokeColor=#dadad3;fontColor=#111111;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="90" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;④ 피드 + 타임라인&lt;/b&gt;&lt;br&gt;같은 글이 두 곳에&lt;br&gt;동시에 뜸" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e4fd8;strokeColor=#173fb0;fontColor=#ffffff;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="90" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;⑤ 공개 링크 공유&lt;/b&gt;&lt;br&gt;프로젝트 페이지 URL 복사&lt;br&gt;(이름을 바꿔도 안 변함)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f6f3;strokeColor=#dadad3;fontColor=#111111;fontSize=12;arcSize=12;" vertex="1" parent="1">
