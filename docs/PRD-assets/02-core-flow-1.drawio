        <mxCell id="ev4" value="&lt;font face=&quot;Menlo, monospace&quot;&gt;project_viewed&lt;/font&gt; · &lt;font face=&quot;Menlo, monospace&quot;&gt;project_followed&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;방문자의 열람·팔로우 (팔로우는 1차 최소 동작)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7edfc;strokeColor=#3f5aa8;fontColor=#111111;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="220" width="210" height="50" as="geometry" />
